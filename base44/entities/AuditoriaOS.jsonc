{
  "name": "AuditoriaOS",
  "type": "object",
  "properties": {
    "ordem_servico_id": {
      "type": "string",
      "description": "ID da Ordem de Servi\u00e7o alterada"
    },
    "numero_os": {
      "type": [
        "string",
        "null"
      ],
      "description": "N\u00famero da OS no momento da altera\u00e7\u00e3o"
    },
    "paciente_nome": {
      "type": [
        "string",
        "null"
      ],
      "description": "Nome do paciente da OS"
    },
    "tipo_evento": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "cancel"
      ],
      "description": "Tipo do evento de auditoria"
    },
    "alterado_por_email": {
      "type": [
        "string",
        "null"
      ],
      "description": "Email do usu\u00e1rio que fez a altera\u00e7\u00e3o"
    },
    "alterado_por_nome": {
      "type": [
        "string",
        "null"
      ],
      "description": "Nome do usu\u00e1rio que fez a altera\u00e7\u00e3o"
    },
    "status_anterior": {
      "type": [
        "string",
        "null"
      ],
      "description": "Status de pagamento anterior"
    },
    "status_novo": {
      "type": [
        "string",
        "null"
      ],
      "description": "Status de pagamento novo"
    },
    "valor_final": {
      "type": [
        "number",
        "null"
      ],
      "description": "Valor final da OS no momento do evento"
    },
    "campos_alterados": {
      "type": "array",
      "description": "Lista de campos que foram alterados",
      "items": {
        "type": "object",
        "properties": {
          "campo": {
            "type": "string"
          },
          "valor_antigo": {},
          "valor_novo": {}
        }
      }
    },
    "resumo": {
      "type": "string",
      "description": "Resumo leg\u00edvel do evento"
    }
  },
  "required": [
    "ordem_servico_id",
    "tipo_evento"
  ]
}