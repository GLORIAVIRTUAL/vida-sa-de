{
  "name": "CategoriaPreco",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da categoria de pre\u00e7o (ex: Particular, Cart\u00e3o Mais Vida, Prefeitura de Imb\u00e9)."
    },
    "descricao": {
      "type": "string",
      "description": "Breve descri\u00e7\u00e3o da categoria."
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo"
      ],
      "default": "Ativo"
    }
  },
  "required": [
    "nome"
  ]
}