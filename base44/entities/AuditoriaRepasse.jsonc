{
  "name": "AuditoriaRepasse",
  "type": "object",
  "properties": {
    "origem": {
      "type": "string",
      "enum": [
        "Medico",
        "Procedimento",
        "TabelaPreco"
      ],
      "description": "Cadastro onde o repasse foi alterado"
    },
    "registro_id": {
      "type": "string",
      "description": "ID do registro alterado"
    },
    "registro_nome": {
      "type": "string",
      "description": "Nome do m\u00e9dico ou procedimento"
    },
    "categoria_nome": {
      "type": [
        "string",
        "null"
      ],
      "description": "Categoria de pre\u00e7o relacionada, quando aplic\u00e1vel"
    },
    "tipo_evento": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete"
      ]
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da altera\u00e7\u00e3o"
    },
    "alterado_por_email": {
      "type": [
        "string",
        "null"
      ]
    },
    "alterado_por_nome": {
      "type": [
        "string",
        "null"
      ]
    },
    "campos_alterados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "campo": {
            "type": "string"
          },
          "valor_antigo": {
            "type": [
              "string",
              "number",
              "boolean",
              "array",
              "object",
              "null"
            ]
          },
          "valor_novo": {
            "type": [
              "string",
              "number",
              "boolean",
              "array",
              "object",
              "null"
            ]
          }
        }
      }
    },
    "resumo": {
      "type": "string"
    }
  },
  "required": [
    "origem",
    "registro_id",
    "tipo_evento",
    "data_hora",
    "campos_alterados"
  ]
}