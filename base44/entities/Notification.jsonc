{
  "name": "Notification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "novo_agendamento",
        "paciente_chamado",
        "lembrete_equipe",
        "agendamento_cancelado",
        "confirmacao_recebida"
      ],
      "description": "O tipo da notifica\u00e7\u00e3o."
    },
    "message": {
      "type": "string",
      "description": "Uma mensagem descritiva para a notifica\u00e7\u00e3o."
    },
    "data": {
      "type": "object",
      "description": "Dados adicionais relacionados ao evento, em formato JSON."
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Indica se a notifica\u00e7\u00e3o j\u00e1 foi processada pelo sistema."
    }
  },
  "required": [
    "type"
  ]
}