{
  "name": "OrdemServico",
  "type": "object",
  "properties": {
    "numero_os": {
      "type": [
        "string",
        "null"
      ],
      "description": "N\u00famero da ordem de servi\u00e7o"
    },
    "agendamento_id": {
      "type": "string",
      "description": "ID do agendamento relacionado"
    },
    "paciente_id": {
      "type": "string",
      "description": "ID do paciente"
    },
    "paciente_nome": {
      "type": [
        "string",
        "null"
      ],
      "description": "Nome do paciente no momento da cria\u00e7\u00e3o (Hist\u00f3rico)"
    },
    "medico_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ID do m\u00e9dico respons\u00e1vel (opcional para exames)"
    },
    "categoria_preco_id": {
      "type": "string",
      "description": "ID da categoria de pre\u00e7o do agendamento"
    },
    "data_execucao": {
      "type": "string",
      "format": "date",
      "description": "Data de execu\u00e7\u00e3o do servi\u00e7o"
    },
    "tipo_servico": {
      "type": "string",
      "enum": [
        "Consulta",
        "Procedimento",
        "Exame"
      ],
      "description": "Tipo do servi\u00e7o executado"
    },
    "procedimento_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ID do procedimento (se aplic\u00e1vel)"
    },
    "exames_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos exames (se aplic\u00e1vel)"
    },
    "valor_total": {
      "type": "number",
      "description": "Valor total original da OS"
    },
    "desconto": {
      "type": "number",
      "description": "Valor do desconto aplicado",
      "default": 0
    },
    "juros": {
      "type": "number",
      "description": "Valor dos juros de parcelamento",
      "default": 0
    },
    "valor_final": {
      "type": "number",
      "description": "Valor final ap\u00f3s desconto e juros"
    },
    "valor_imposto": {
      "type": "number",
      "description": "Valor do imposto descontado (10% para conv\u00eanios)",
      "default": 0
    },
    "valor_repasse_medico": {
      "type": [
        "number",
        "null"
      ],
      "description": "Valor do repasse ao m\u00e9dico"
    },
    "valor_repasse_laboratorio": {
      "type": [
        "number",
        "null"
      ],
      "description": "Valor do repasse ao laborat\u00f3rio"
    },
    "valor_clinica": {
      "type": [
        "number",
        "null"
      ],
      "description": "Valor que fica para a cl\u00ednica"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "Dinheiro",
        "Cart\u00e3o D\u00e9bito",
        "Cart\u00e3o Cr\u00e9dito",
        "PIX",
        "Transfer\u00eancia",
        "Conv\u00eanio",
        "M\u00faltiplas Formas"
      ],
      "description": "Forma de pagamento"
    },
    "pagamentos_detalhados": {
      "type": "array",
      "description": "Detalhamento quando forma_pagamento \u00e9 'M\u00faltiplas Formas'",
      "items": {
        "type": "object",
        "properties": {
          "forma": {
            "type": "string",
            "enum": [
              "Dinheiro",
              "Cart\u00e3o D\u00e9bito",
              "Cart\u00e3o Cr\u00e9dito",
              "PIX",
              "Transfer\u00eancia"
            ]
          },
          "valor": {
            "type": "number"
          }
        }
      }
    },
    "nome_prefeitura": {
      "type": [
        "string",
        "null"
      ],
      "description": "Nome da prefeitura selecionada, se aplic\u00e1vel"
    },
    "parcelas": {
      "type": "number",
      "description": "N\u00famero de parcelas (para cart\u00e3o cr\u00e9dito)",
      "default": 1
    },
    "bandeira_cartao": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bandeira do cart\u00e3o usado"
    },
    "status_pagamento": {
      "type": "string",
      "enum": [
        "Pendente",
        "Pago",
        "Cancelado"
      ],
      "default": "Pendente",
      "description": "Status do pagamento"
    },
    "data_pagamento": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Data/hora do pagamento"
    },
    "repasse_realizado": {
      "type": "boolean",
      "default": false,
      "description": "Se o repasse ao m\u00e9dico j\u00e1 foi realizado"
    },
    "data_repasse": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Data/hora em que o repasse foi realizado"
    },
    "observacoes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Observa\u00e7\u00f5es da OS"
    },
    "itens": {
      "type": [
        "array",
        "null"
      ],
      "description": "Itens detalhados da OS",
      "items": {
        "type": "object",
        "properties": {
          "descricao": {
            "type": "string"
          },
          "valor_unitario": {
            "type": "number"
          },
          "quantidade": {
            "type": "number"
          },
          "valor_total": {
            "type": "number"
          }
        }
      }
    },
    "transaction_id": {
      "type": "string",
      "description": "ID da transa\u00e7\u00e3o na EvoluServices"
    },
    "nsu": {
      "type": "string",
      "description": "NSU da transa\u00e7\u00e3o"
    },
    "autorizacao": {
      "type": "string",
      "description": "C\u00f3digo de autoriza\u00e7\u00e3o da transa\u00e7\u00e3o"
    },
    "gerado_por": {
      "type": [
        "string",
        "null"
      ],
      "description": "Nome do usu\u00e1rio que gerou a OS"
    },
    "alterado_por_email": {
      "type": [
        "string",
        "null"
      ],
      "description": "Email do usu\u00e1rio logado que fez a \u00faltima altera\u00e7\u00e3o (para auditoria)"
    },
    "alterado_por_nome": {
      "type": [
        "string",
        "null"
      ],
      "description": "Nome do usu\u00e1rio logado que fez a \u00faltima altera\u00e7\u00e3o (para auditoria)"
    }
  },
  "required": [
    "agendamento_id",
    "paciente_id",
    "data_execucao",
    "tipo_servico",
    "valor_final",
    "categoria_preco_id"
  ]
}