{
  "name": "Turma",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da turma (ex: Hidrogin\u00e1stica Manh\u00e3)"
    },
    "modalidade": {
      "type": "string",
      "enum": [
        "Hidrogin\u00e1stica",
        "Pilates",
        "Nata\u00e7\u00e3o",
        "Outro"
      ],
      "description": "Tipo de atividade"
    },
    "medico_id": {
      "type": "string",
      "description": "Professor/Profissional respons\u00e1vel"
    },
    "horario_inicio": {
      "type": "string",
      "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$",
      "description": "Hor\u00e1rio de in\u00edcio da aula"
    },
    "horario_fim": {
      "type": "string",
      "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$",
      "description": "Hor\u00e1rio de t\u00e9rmino da aula"
    },
    "dias_semana": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Dias da semana que a turma acontece (0=Domingo, 1=Segunda...)"
    },
    "capacidade_maxima": {
      "type": "number",
      "default": 10,
      "description": "N\u00famero m\u00e1ximo de alunos"
    },
    "qtd_alunos": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de alunos matriculados (atualizado automaticamente)"
    },
    "cor": {
      "type": "string",
      "description": "Cor para identifica\u00e7\u00e3o no calend\u00e1rio (hex)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativa",
        "Inativa"
      ],
      "default": "Ativa"
    }
  },
  "required": [
    "nome",
    "modalidade",
    "medico_id",
    "horario_inicio",
    "dias_semana"
  ]
}