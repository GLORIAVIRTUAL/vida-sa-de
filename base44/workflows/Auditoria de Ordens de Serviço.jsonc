{
  "name": "Auditoria de Ordens de Servi\u00e7o",
  "description": "Registra automaticamente todas as altera\u00e7\u00f5es em OS, especialmente cancelamentos, identificando o respons\u00e1vel.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update",
        "delete"
      ],
      "entity_name": "OrdemServico"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auditoria_de_ordens_de_servi_o",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "auditarAlteracaoOS",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "auditarAlteracaoOS"
  }
}